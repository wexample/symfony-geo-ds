{
  "name": "wexample/symfony-geo-ds",
  "description": "Design-system side of symfony-geo: an open source map with pins and a route",
  "version": "3.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyGeoDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyGeoDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=35.0.0",
    "wexample/symfony-geo": ">=6.0.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-loader": ">=23.0.0",
    "wexample/symfony-forms": ">=12.0.0",
    "symfony/intl": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}